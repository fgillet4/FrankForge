{
  "name": "frankforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "wasm": "cd ../rust && cargo build --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir pkg target/wasm32-unknown-unknown/release/frankforge_core.wasm"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "@types/seedrandom": "^3.0.8"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3"
  }
}
